# Environment Configuration Template
# Copy this to .env and fill in your values

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Choose provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4

# Alternative: Gemini Configuration  
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-pro

# ============================================================================
# Application Configuration
# ============================================================================

# Debug mode (True for development, False for production)
DEBUG=True

# Environment: development, staging, production
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# Speech Recognition Configuration
# ============================================================================

# Whisper model: tiny, base, small, medium, large
# (smaller = faster but less accurate, larger = slower but more accurate)
WHISPER_MODEL=base

# Audio sample rate (Hz)
AUDIO_SAMPLE_RATE=16000

# ============================================================================
# Text Processing Configuration
# ============================================================================

# Chunk size in characters
CHUNK_SIZE=500

# Overlap between chunks (characters)
CHUNK_OVERLAP=100

# Minimum chunk size (characters)
MIN_CHUNK_SIZE=100

# ============================================================================
# Embeddings Configuration
# ============================================================================

# Embedding model (Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding vector dimension (usually 384 for all-MiniLM-L6-v2)
EMBEDDING_DIMENSION=384

# Batch size for embedding generation
BATCH_SIZE=32

# ============================================================================
# Vector Database (FAISS) Configuration
# ============================================================================

# Enable GPU for FAISS (if available)
FAISS_ENABLE_GPU=False

# ============================================================================
# RAG Configuration
# ============================================================================

# Number of top-k results to retrieve
RETRIEVAL_TOP_K=5

# Minimum similarity threshold (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.5

# Maximum context size to pass to LLM (characters)
CONTEXT_WINDOW_SIZE=2000

# ============================================================================
# LLM Parameters
# ============================================================================

# Maximum tokens in LLM response
MAX_TOKENS=2000

# Temperature (0.0 - 1.0): Lower = more deterministic, Higher = more creative
TEMPERATURE=0.7

# Top-p (nucleus sampling): 0.0 - 1.0
TOP_P=0.9

# Top-k: Number of highest probability candidates
TOP_K=40

# ============================================================================
# Analysis Configuration
# ============================================================================

# Sentiment labels
SENTIMENT_LABELS=positive,neutral,negative

# Action item confidence threshold
ACTION_ITEM_CONFIDENCE_THRESHOLD=0.6

# ============================================================================
# Performance Configuration
# ============================================================================

# Enable caching
ENABLE_CACHING=True

# Cache TTL in seconds
CACHE_TTL=3600

# Enable async processing
ENABLE_ASYNC_PROCESSING=True

# Maximum worker threads
MAX_WORKERS=4

# ============================================================================
# Timeout Configuration (in seconds)
# ============================================================================

# Transcription timeout
TRANSCRIPTION_TIMEOUT=300

# LLM API call timeout
LLM_TIMEOUT=120

# Embedding generation timeout
EMBEDDING_TIMEOUT=60
